# Configuración de Entorno de Pruebas
NODE_ENV=test
PORT=2301
FRONTEND_URL=http://localhost:5173

# Configuración de la base de datos (PostgreSQL Local)
# Ajusta estas credenciales según tu instalación local de PostgreSQL en pgAdmin
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/puravida_test
DB_SSL=false

# Configuración de JWT
JWT_SECRET=test_secret_key_for_testing_purposes_only
JWT_EXPIRE=1h

# Otras variables necesarias para tests
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=500

# Configuración básica
NODE_ENV=development
PORT=2300
FRONTEND_URL=http://localhost:5173

# Configuración de JWT (debe ser una clave secreta larga y compleja)
JWT_SECRET=replace_this_with_a_strong_random_secret_key_at_least_32_chars_long
JWT_EXPIRE=7d

# Configuración de cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false # Cambiar a true en producción

# Configuración de la base de datos
DATABASE_URL=postgresql://your_user:your_password@your_host.neon.tech/your_database?sslmode=require
DB_SSL=true

# Configuración de Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
CALLBACK_URL=http://localhost:2300/api/auth/google/callback

# Configuración HTTPS (para producción)
USE_HTTPS=false
SSL_KEY_PATH=./ssl/key.pem
SSL_CERT_PATH=./ssl/cert.pem

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutos
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# Swagger
SWAGGER_PASSWORD=change_this_in_production

# Configuración de seguridad adicional
BCRYPT_SALT_ROUNDS=12
API_KEY=replace_with_secure_api_key_for_external_services

